{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "jsx": "preserve",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "vue-syntax-highlighter": ["./src/index.ts"],
      "vue-syntax-highlighter/engines/*": ["./src/engines/*/index.ts"],
      "vue-syntax-highlighter/themes": ["./src/themes/index.ts"],
      "vue-syntax-highlighter/styles.css": ["./src/styles/base.css"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/setup.ts",
    "tests/types/**/*.ts",
    "scripts/**/*.mjs",
    "docs/**/*.ts",
    "docs/**/*.vue",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist", "docs/.vitepress/dist", "docs/.vitepress/cache"]
}
