{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "tests/setup.ts",
    "tests/types/**/*.ts",
    "docs/**/*.ts",
    "docs/**/*.vue"
  ],
  "exclude": ["node_modules", "dist", "tests/fixtures", "docs/.vitepress/dist", "docs/.vitepress/cache"]
}
